    }
  },
  "devDependencies": {},
  "exports": {
    ".": "./src/index.js",
    "./tokens": "./src/tokens/index.js",
    "./themes": "./src/themes/index.js",
    "./components": "./src/components/index.js",
    "./layouts": "./src/layouts/index.js",
    "./notifications": "./src/notifications/index.js",
    "./onboarding": "./src/onboarding/index.js",
    "./hooks": "./src/hooks/index.js",
    "./storage": "./src/storage/index.js",
    "./styles.css": "./dist/styles.css",
    "./react-native": "./src/react-native.js",
    "./native/spacing.json": "./native/spacing.json",
    "./native/main-app-loading.json": "./native/main_app_loading.json",
    "./native/title-typography.json": "./native/title_typography.json"
  }

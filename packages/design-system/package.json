{
  "name": "@min-apps/design-system",
  "version": "1.0.0",
  "description": "Unified design system for the min apps suite (WatchedIt, podlink, yourtube, Cyclismo guide)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:native",
    "build:native": "node scripts/build-native-tokens.js"
  },
  "keywords": [
